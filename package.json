{
	"name": "evm-kms-signer",
	"version": "1.0.1",
	"type": "module",
	"description": "AWS/GCP KMS-based Ethereum signer for viem with enterprise-grade security. Sign transactions and messages using keys stored in AWS or GCP KMS without exposing private keys.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"ethereum",
		"aws",
		"kms",
		"gcp",
		"google-cloud",
		"viem",
		"signer",
		"evm",
		"crypto",
		"blockchain",
		"wallet",
		"security"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gtg7784/evm-kms-signer.git"
	},
	"bugs": {
		"url": "https://github.com/gtg7784/evm-kms-signer/issues"
	},
	"homepage": "https://github.com/gtg7784/evm-kms-signer#readme",
	"scripts": {
		"type-check": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"start": "tsx src/index.ts",
		"build": "tsc",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"example:sign": "tsx examples/sign-message.ts",
		"example:tx": "tsx examples/send-transaction.ts",
		"example:gcp-sign": "tsx examples/gcp-sign-message.ts",
		"example:gcp-tx": "tsx examples/gcp-send-transaction.ts"
	},
	"author": "Alan Go <tae.gun7784@gmail.com>",
	"license": "MIT",
	"engines": {
		"node": ">=18.0.0"
	},
	"packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
	"peerDependencies": {
		"viem": "^2.0.0"
	},
	"dependencies": {
		"@aws-sdk/client-kms": "^3.0.0",
		"@google-cloud/kms": "^5.2.1",
		"abitype": "^1.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@types/node": "^24.10.0",
		"@vitest/coverage-v8": "4.1.2",
		"dotenv": "^17.2.3",
		"tsx": "^4.20.6",
		"typescript": "^6.0.0",
		"viem": "^2.0.0",
		"vitest": "^4.0.8"
	},
	"pnpm": {
		"overrides": {
			"jws": "^4.0.1",
			"rimraf>glob": "^13.0.0"
		}
	}
}
